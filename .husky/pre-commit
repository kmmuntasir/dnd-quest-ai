#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

# Check for .env files being committed
if git diff --cached --name-only | grep -q '\.env$'; then
  echo "ERROR: Attempting to commit .env file!"
  echo "   .env files contain sensitive credentials and should not be committed."
  echo "   Please remove the .env file from your staging area:"
  echo "   git reset HEAD -- <path-to-.env>"
  exit 1
fi

# Check for .env.local files
if git diff --cached --name-only | grep -q '\.env\.local$'; then
  echo "ERROR: Attempting to commit .env.local file!"
  echo "   This may contain sensitive information."
  exit 1
fi

# Check for secrets only in ADDED lines (not deletions)
# This prevents false positives when deleting files that contained keys
if git diff --cached --diff-filter=d -U0 | grep '^+' | grep -E '(gsk_[A-Za-z0-9]{20,}|sk_[A-Za-z0-9]{20,})' > /dev/null 2>&1; then
  echo "ERROR: Potential API key detected in staged changes!"
  echo "   Please ensure no API keys or secrets are being committed."
  exit 1
fi

# Run lint-staged for backend if backend files changed
if git diff --cached --name-only | grep -q '^backend/'; then
  echo "Running lint-staged for backend..."
  cd backend && npx lint-staged && cd ..
fi

echo "Pre-commit checks passed"
