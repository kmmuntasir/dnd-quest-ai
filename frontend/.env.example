# API Configuration
# The backend API URL (default: http://localhost:3000)
VITE_API_URL=http://localhost:3000

# API request timeout in milliseconds (default: 30000)
VITE_API_TIMEOUT=30000

# WebSocket URL for real-time features (optional)
# VITE_WS_URL=ws://localhost:3000

# Feature Flags
# Enable offline mode (default: false)
# VITE_ENABLE_OFFLINE=false

# Enable analytics (default: false)
# VITE_ENABLE_ANALYTICS=false

# Debug mode (default: true in development)
# VITE_DEBUG=false
