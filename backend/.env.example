# ===========================================
# Dungeons & Dragons AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# -------------------------------------------
# API Keys (Required)
# -------------------------------------------

# Groq API Key - Get yours at https://console.groq.com/
# Used for AI-powered adventure and story generation
GROQ_API_KEY=your_groq_api_key_here

# Groq Model to use (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# Pollinations API Key (optional)
# Used for image generation - Get yours at https://pollinations.ai/
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# -------------------------------------------
# Server Configuration (Optional)
# -------------------------------------------

# Server port (default: 3000)
PORT=3000

# Environment: development, test, production
NODE_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# JWT Secret for authentication (REQUIRED in production)
# Generate a secure random string for production
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# -------------------------------------------
# Database Configuration (Optional)
# -------------------------------------------

# Path to SQLite database file (relative to backend directory)
DATABASE_PATH=../database/dnd-game.db

# -------------------------------------------
# Key Rotation Guide
# -------------------------------------------
# To rotate API keys:
# 1. Generate new key from the provider's console
# 2. Update the key in this .env file
# 3. Restart the server
# 4. Verify the new key works
# 5. Revoke the old key from the provider's console
#
# Recommended rotation frequency:
# - Every 90 days for production
# - Immediately if key is suspected to be compromised
# -------------------------------------------
