# ===========================================
# Dungeons & Dragons AI - Environment Configuration
# ===========================================
# Copy this file to .env and fill in your values
# NEVER commit the actual .env file to version control

# -------------------------------------------
# API Keys (Required)
# -------------------------------------------

# Groq API Key - Get yours at https://console.groq.com/
# Used for AI-powered adventure and story generation
GROQ_API_KEY=your_groq_api_key_here

# Groq Model to use (optional, defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# -------------------------------------------
# Image Provider Configuration
# -------------------------------------------

# Primary image provider: aihorde-flux (fast+quality), aihorde-sdxl (quality), aihorde (speed), pollinations
# Flux is fast and produces high-quality images
IMAGE_PROVIDER_PRIMARY=aihorde-flux

# Fallback providers (comma-separated, tried in order if primary fails)
# Falls back to SDXL (quality), then fast aihorde, then pollinations
IMAGE_PROVIDER_FALLBACKS=aihorde-sdxl,aihorde,pollinations

# Pollinations API Key (optional, removes watermark)
# Get yours at https://pollinations.ai/
POLLINATIONS_API_KEY=your_pollinations_api_key_here

# Pollinations timeout in milliseconds
POLLINATIONS_TIMEOUT=30000

# -------------------------------------------
# AI Horde Configuration (Fast SD Provider)
# -------------------------------------------

# AI Horde API Key - Get yours at https://aihorde.net/register
# This key is shared between all AI Horde providers (aihorde, sdxl, flux)
AI_HORDE_API_KEY=your_ai_horde_api_key_here

# AI Horde model to use (stable_diffusion is fastest)
AI_HORDE_MODEL=stable_diffusion

# Generation steps (fewer = faster, less detail)
AI_HORDE_STEPS=20

# Sampler algorithm (k_euler_a is fast)
AI_HORDE_SAMPLER=k_euler_a

# Image dimensions (smaller = faster)
AI_HORDE_WIDTH=512
AI_HORDE_HEIGHT=512

# CFG Scale (how closely to follow prompt)
AI_HORDE_CFG_SCALE=7

# Polling interval for async generation (milliseconds)
AI_HORDE_POLL_INTERVAL=3000

# Maximum poll attempts before timeout
AI_HORDE_MAX_POLL_ATTEMPTS=180

# Request timeout (milliseconds)
AI_HORDE_TIMEOUT=120000

# -------------------------------------------
# AI Horde SDXL Configuration (High Quality Provider)
# -------------------------------------------
# SDXL produces much higher quality images but takes ~60-90 seconds
# Uses same API key as AI Horde above

# SDXL model (AlbedoBase XL is best quality on Horde)
AI_HORDE_SDXL_MODEL=AlbedoBase XL (SDXL)

# Generation steps (30 is sweet spot for SDXL quality)
AI_HORDE_SDXL_STEPS=30

# Sampler algorithm (k_dpmpp_2m is best for SDXL)
AI_HORDE_SDXL_SAMPLER=k_dpmpp_2m

# Image dimensions (SDXL MUST be 1024x1024 for best quality)
AI_HORDE_SDXL_WIDTH=1024
AI_HORDE_SDXL_HEIGHT=1024

# CFG Scale
AI_HORDE_SDXL_CFG_SCALE=7

# Karras noise scheduler (improves details)
AI_HORDE_SDXL_KARRAS=true

# Polling interval (SDXL is slower, poll less frequently)
AI_HORDE_SDXL_POLL_INTERVAL=5000

# Maximum poll attempts (15 minutes max for SDXL)
AI_HORDE_SDXL_MAX_POLL_ATTEMPTS=180

# Request timeout (3 minutes for SDXL)
AI_HORDE_SDXL_TIMEOUT=180000

# -------------------------------------------
# AI Horde Flux Configuration (Fast + Quality Provider)
# -------------------------------------------
# Flux.1-Schnell is fast (~4 steps) and produces excellent results
# Prefers natural language prompts over comma-separated tags
# Uses same API key as AI Horde above

# Flux model (Flux.1-Schnell fp8 is the main Flux model on Horde)
AI_HORDE_FLUX_MODEL=Flux.1-Schnell fp8 (Compact)

# Generation steps (Flux-Schnell needs only 4 steps!)
AI_HORDE_FLUX_STEPS=4

# Sampler algorithm (MUST be k_euler for Flux)
AI_HORDE_FLUX_SAMPLER=k_euler

# Image dimensions (Flux is native to 1024x1024)
AI_HORDE_FLUX_WIDTH=1024
AI_HORDE_FLUX_HEIGHT=1024

# CFG Scale (MUST be 1 for Flux)
AI_HORDE_FLUX_CFG_SCALE=1

# Polling interval (Flux is fast, check often)
AI_HORDE_FLUX_POLL_INTERVAL=3000

# Maximum poll attempts (9 minutes max)
AI_HORDE_FLUX_MAX_POLL_ATTEMPTS=180

# Request timeout (3 minutes for Flux)
AI_HORDE_FLUX_TIMEOUT=180000

# -------------------------------------------
# Text Provider Configuration
# -------------------------------------------

# Primary text provider (currently only groq supported)
TEXT_PROVIDER_PRIMARY=groq

# Fallback providers (comma-separated)
TEXT_PROVIDER_FALLBACKS=

# Groq timeout in milliseconds
GROQ_TIMEOUT=45000

# -------------------------------------------
# Server Configuration (Optional)
# -------------------------------------------

# Server port (default: 3000)
PORT=3000

# Environment: development, test, production
NODE_ENV=development

# Log level: debug, info, warn, error
LOG_LEVEL=info

# JWT Secret for authentication (REQUIRED in production)
# Generate a secure random string for production
JWT_SECRET=your-secure-jwt-secret-key-change-in-production

# -------------------------------------------
# Database Configuration (Optional)
# -------------------------------------------

# Path to SQLite database file (relative to backend directory)
DATABASE_PATH=../database/dnd-game.db

# -------------------------------------------
# Key Rotation Guide
# -------------------------------------------
# To rotate API keys:
# 1. Generate new key from the provider's console
# 2. Update the key in this .env file
# 3. Restart the server
# 4. Verify the new key works
# 5. Revoke the old key from the provider's console
#
# Recommended rotation frequency:
# - Every 90 days for production
# - Immediately if key is suspected to be compromised
# -------------------------------------------
